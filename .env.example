# Copy this file to .env for local development only.
# These credentials are local defaults and must never be used in production.
API_PORT=8080
LOG_LEVEL=debug

# Public short-link origin. Set this to the deployed domain in production.
PUBLIC_BASE_URL=http://localhost:8080

# JWT access-token signing. Replace this local-only value in every deployed environment.
JWT_SIGNING_KEY=local-development-only-signing-key-change-before-deploy
JWT_ISSUER=url-shortener
JWT_AUDIENCE=url-shortener-api

POSTGRES_DB=shortener
POSTGRES_USER=shortener
POSTGRES_PASSWORD=local_dev_password
POSTGRES_PORT=5432

# PostgreSQL pool settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s

REDIS_PORT=6379
